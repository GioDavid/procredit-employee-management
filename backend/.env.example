# Copy this file to .env and fill in the values for the local environment.
# Load it before running the API:  set -a && source .env && set +a
#
# Names follow the .NET configuration convention (double underscore
# as the section separator), so they override appsettings.json.

# SQL Server connection string (use the SA password of your instance)
ConnectionStrings__ProCreditRRHH=Server=localhost,1433;Database=ProCreditRRHH;User Id=sa;Password=<SA_PASSWORD>;TrustServerCertificate=True;Encrypt=True;

# Preconfigured test user for login
TestUser__Username=admin
TestUser__Password=<TEST_USER_PASSWORD>

# JWT signing key (long random string)
Jwt__SecretKey=<RANDOM_STRING_AT_LEAST_32_CHARACTERS>

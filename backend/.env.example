# Copia este archivo a .env y completa los valores para el entorno local.
# Cárgalo antes de ejecutar la API:  set -a && source .env && set +a
#
# Los nombres usan la convención de configuración de .NET (doble guion bajo
# como separador de secciones), por lo que sobrescriben appsettings.json.

# Cadena de conexión a SQL Server (usa la clave SA de tu instancia)
ConnectionStrings__ProCreditRRHH=Server=localhost,1433;Database=ProCreditRRHH;User Id=sa;Password=<CLAVE_SA>;TrustServerCertificate=True;Encrypt=True;

# Usuario de prueba preconfigurado para el login
UsuarioPrueba__Usuario=admin
UsuarioPrueba__Clave=<CLAVE_DE_PRUEBA>

# Clave de firma del JWT (cadena larga y aleatoria)
Jwt__ClaveSecreta=<CADENA_ALEATORIA_MINIMO_32_CARACTERES>
